workflow:
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push"'
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'
    - if: '$CI_PIPELINE_SOURCE == "web"'
    - when: never
  auto_cancel:
    on_new_commit: interruptible

stages:
  - validate
  - test
  - build
  - security
  - gitops

# ----------------------------
# Global speed + defaults
# ----------------------------
default:
  interruptible: true

cache:
  # Share npm cache across branches (fast) — adjust if you prefer per-branch cache
  key: "$CI_PROJECT_NAME"
  paths:
    - .npm/
  policy: pull-push

variables:
  # Use mirrored images (private EKS + rate limits)
  NODE_IMAGE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/base/node:20"
  POSTGRES_IMAGE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/base/postgres:15"
  KANIKO_IMAGE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/base/kaniko:debug"
  TRIVY_IMAGE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/base/trivy:latest"
  ALPINE_IMAGE: "123456789012.dkr.ecr.us-east-1.amazonaws.com/base/alpine:3.20"

  # Your app image destination (one repo per app)
  ECR_DEST: "123456789012.dkr.ecr.us-east-1.amazonaws.com/api"

  # Kaniko cache repo (recommended)
  KANIKO_CACHE_REPO: "123456789012.dkr.ecr.us-east-1.amazonaws.com/cache/kaniko-api"

  # npm cache location
  NPM_CONFIG_CACHE: "$CI_PROJECT_DIR/.npm"

  # GitOps settings (set these as masked/protected CI variables)
  # GITOPS_PROJECT_ID: "1234"
  # GITOPS_REPO_URL: "https://gitlab.yourdomain.com/mygroup/gitops.git"
  # GITOPS_TOKEN: "<Project Access Token or PAT with api + write_repository>"
  # GITOPS_TARGET_BRANCH: "main"
  # GITOPS_API_VALUES_FILE_PROD: "apps/api/values-prod.yaml"
  GITOPS_TARGET_BRANCH: "main"
  GITOPS_API_VALUES_FILE_PROD: "apps/api/values-prod.yaml"

# ----------------------------
# Templates
# ----------------------------
.node_job:
  image: "$NODE_IMAGE"
  before_script:
    - npm ci

# ----------------------------
# VALIDATE (parallel)
# ----------------------------
prettier:
  stage: validate
  extends: .node_job
  script:
    - npm run format-check

type_check:
  stage: validate
  extends: .node_job
  script:
    - npm run type-check

lint:
  stage: validate
  extends: .node_job
  script:
    - npm run lint

# ----------------------------
# DB integration tests (K8s executor-friendly)
# ----------------------------
integration_tests:
  stage: test
  extends: .node_job
  services:
    - name: "$POSTGRES_IMAGE"
      alias: db
  variables:
    # Postgres container vars
    POSTGRES_DB: "test"
    POSTGRES_USER: "test"
    POSTGRES_PASSWORD: "test"

    # App vars (map these to whatever your app expects)
    DB_HOST: "db"
    DB_PORT: "5432"
    DB_DATABASE: "test"
    DB_USERNAME: "test"
    DB_PASSWORD: "test"
  script:
    # wait for DB (simple TCP check)
    - |
      node -e "const net=require('net'); const host=process.env.DB_HOST; const port=+process.env.DB_PORT;
      let n=0; const t=setInterval(()=>{n++; const s=net.connect(port,host,()=>{console.log('DB up'); s.end(); clearInterval(t);});
      s.on('error',()=>{ if(n>30){console.error('DB not ready'); process.exit(1);} });},2000);"
    - npm run test-coverage
  artifacts:
    when: always
    paths:
      - coverage-report.txt
  needs: ["prettier", "type_check", "lint"]

# ----------------------------
# BUILD: MR builds feature image only
# Tag = <branch-slug>-<shortsha>
# ----------------------------
build_feature_image:
  stage: build
  image:
    name: "$KANIKO_IMAGE"
    entrypoint: [""]
  script:
    - TAG="${CI_COMMIT_REF_SLUG}-${CI_COMMIT_SHORT_SHA}"
    - echo "FEATURE_TAG=$TAG" > build.env
    - /kaniko/executor
        --context .
        --dockerfile Dockerfile
        --destination "${ECR_DEST}:${TAG}"
        --cache=true
        --cache-repo "${KANIKO_CACHE_REPO}"
  artifacts:
    reports:
      dotenv: build.env
  needs: ["integration_tests"]
  rules:
    - if: '$CI_PIPELINE_SOURCE == "merge_request_event"'

# ----------------------------
# BUILD: main builds immutable SHA tag only (no latest)
# ----------------------------
build_main_image:
  stage: build
  image:
    name: "$KANIKO_IMAGE"
    entrypoint: [""]
  script:
    - TAG="${CI_COMMIT_SHORT_SHA}"
    - echo "MAIN_TAG=$TAG" > build.env
    - /kaniko/executor
        --context .
        --dockerfile Dockerfile
        --destination "${ECR_DEST}:${TAG}"
        --cache=true
        --cache-repo "${KANIKO_CACHE_REPO}"
  artifacts:
    reports:
      dotenv: build.env
  needs: ["integration_tests"]
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"'
  resource_group: production

# ----------------------------
# BUILD: release tag builds immutable release tag (vX.Y.Z)
# ----------------------------
build_release_image:
  stage: build
  image:
    name: "$KANIKO_IMAGE"
    entrypoint: [""]
  script:
    - TAG="${CI_COMMIT_TAG}"
    - echo "RELEASE_TAG=$TAG" > build.env
    - /kaniko/executor
        --context .
        --dockerfile Dockerfile
        --destination "${ECR_DEST}:${TAG}"
        --cache=true
        --cache-repo "${KANIKO_CACHE_REPO}"
  artifacts:
    reports:
      dotenv: build.env
  needs: ["integration_tests"]
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'
  resource_group: production

# ----------------------------
# SECURITY: scan image BEFORE opening GitOps MR
# Fail on HIGH/CRITICAL (tune as desired)
# ----------------------------
scan_main_image:
  stage: security
  image: "$TRIVY_IMAGE"
  script:
    - trivy image --exit-code 1 --severity HIGH,CRITICAL "${ECR_DEST}:${CI_COMMIT_SHORT_SHA}"
  needs: ["build_main_image"]
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"'
  resource_group: production

scan_release_image:
  stage: security
  image: "$TRIVY_IMAGE"
  script:
    - trivy image --exit-code 1 --severity HIGH,CRITICAL "${ECR_DEST}:${CI_COMMIT_TAG}"
  needs: ["build_release_image"]
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'
  resource_group: production

# ----------------------------
# GITOPS: open MR in GitOps repo (prod) ONLY on main or release tags
# Requires:
#  - GITOPS_TOKEN (api + write_repository)
#  - GITOPS_PROJECT_ID
#  - GITOPS_REPO_URL
# ----------------------------
open_gitops_mr_prod_main:
  stage: gitops
  image: "$ALPINE_IMAGE"
  before_script:
    - apk add --no-cache git curl jq yq
  script:
    - : "${GITOPS_TOKEN:?Missing GITOPS_TOKEN}"
    - : "${GITOPS_PROJECT_ID:?Missing GITOPS_PROJECT_ID}"
    - : "${GITOPS_REPO_URL:?Missing GITOPS_REPO_URL}"

    - TAG="${CI_COMMIT_SHORT_SHA}"
    - BRANCH="deploy-api-prod-${TAG}"

    # clone using token
    - git clone "https://oauth2:${GITOPS_TOKEN}@${GITOPS_REPO_URL#https://}" gitops
    - cd gitops
    - git checkout -b "${BRANCH}"

    # update Helm values
    - yq -i ".image.tag = \"${TAG}\"" "${GITOPS_API_VALUES_FILE_PROD}"

    - git config user.email "ci@gitlab"
    - git config user.name "GitLab CI"
    - git add "${GITOPS_API_VALUES_FILE_PROD}"
    - git commit -m "api(prod): deploy ${TAG}" || echo "No changes"
    - git push origin "${BRANCH}"

    # create MR via API
    - |
      curl -sS --request POST \
        --header "PRIVATE-TOKEN: ${GITOPS_TOKEN}" \
        --data "source_branch=${BRANCH}" \
        --data "target_branch=${GITOPS_TARGET_BRANCH}" \
        --data-urlencode "title=Deploy API ${TAG} to prod" \
        --data-urlencode "description=Built from main commit ${CI_COMMIT_SHA}. Image: ${ECR_DEST}:${TAG}" \
        "https://${CI_SERVER_HOST}/api/v4/projects/${GITOPS_PROJECT_ID}/merge_requests" | jq -r '.web_url'
  needs: ["scan_main_image"]
  rules:
    - if: '$CI_PIPELINE_SOURCE == "push" && $CI_COMMIT_BRANCH == "main"'
  resource_group: production

open_gitops_mr_prod_release:
  stage: gitops
  image: "$ALPINE_IMAGE"
  before_script:
    - apk add --no-cache git curl jq yq
  script:
    - : "${GITOPS_TOKEN:?Missing GITOPS_TOKEN}"
    - : "${GITOPS_PROJECT_ID:?Missing GITOPS_PROJECT_ID}"
    - : "${GITOPS_REPO_URL:?Missing GITOPS_REPO_URL}"

    - TAG="${CI_COMMIT_TAG}"
    - BRANCH="deploy-api-prod-${TAG}"

    - git clone "https://oauth2:${GITOPS_TOKEN}@${GITOPS_REPO_URL#https://}" gitops
    - cd gitops
    - git checkout -b "${BRANCH}"

    - yq -i ".image.tag = \"${TAG}\"" "${GITOPS_API_VALUES_FILE_PROD}"

    - git config user.email "ci@gitlab"
    - git config user.name "GitLab CI"
    - git add "${GITOPS_API_VALUES_FILE_PROD}"
    - git commit -m "api(prod): deploy ${TAG}" || echo "No changes"
    - git push origin "${BRANCH}"

    - |
      curl -sS --request POST \
        --header "PRIVATE-TOKEN: ${GITOPS_TOKEN}" \
        --data "source_branch=${BRANCH}" \
        --data "target_branch=${GITOPS_TARGET_BRANCH}" \
        --data-urlencode "title=Deploy API ${TAG} to prod" \
        --data-urlencode "description=Release tag ${TAG}. Image: ${ECR_DEST}:${TAG}" \
        "https://${CI_SERVER_HOST}/api/v4/projects/${GITOPS_PROJECT_ID}/merge_requests" | jq -r '.web_url'
  needs: ["scan_release_image"]
  rules:
    - if: '$CI_COMMIT_TAG =~ /^v\d+\.\d+\.\d+$/'
  resource_group: production
